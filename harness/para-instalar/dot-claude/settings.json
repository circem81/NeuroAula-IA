{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node --test *)",
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./AGENTS.md)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git commit --amend *)",
      "Bash(git reset --hard *)",
      "Bash(supabase *)",
      "Bash(npx supabase *)",
      "Bash(wrangler *)",
      "Bash(npx wrangler *)",
      "Bash(npx nitro deploy *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guardia.mjs\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*[Ss]upabase.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guardia.mjs\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
